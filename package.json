{
  "name": "@ashusevim/markdown-processor",
  "publishConfig": {
    "access": "public"
  },
  "version": "2.3.0",
  "description": "marcus — a zero-dependency Markdown to HTML CLI and library that verifies its own output: safe-by-default escaping, line-numbered diagnostics for CI, and LLM-artifact repair",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "marcus": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('dist/cli.js', 0o755)\"",
    "pretest": "npm run build",
    "test": "node --test \"test/*.test.ts\"",
    "start": "node dist/cli.js"
  },
  "keywords": [
    "markdown",
    "html",
    "cli",
    "converter",
    "markdown-to-html",
    "markdown-parser",
    "diagnostics",
    "llm",
    "llm-output",
    "sanitize",
    "security",
    "zero-dependency"
  ],
  "author": "Ashish Prajapati",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashusevim/Markdown-Processor.git"
  },
  "homepage": "https://github.com/ashusevim/Markdown-Processor#readme",
  "bugs": {
    "url": "https://github.com/ashusevim/Markdown-Processor/issues"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  }
}
